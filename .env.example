# -----------------------------------------------------------------------------
# ACI Career EDGE Assess — Environment Variables Specification
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# NEVER commit .env or actual production credentials to version control.

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL Connection Strings
# -----------------------------------------------------------------------------
# Connect through Supabase Transaction Pooler (PgBouncer - Port 6543) for high concurrency (500+ users)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# Direct connection to the database (Port 5432) for running migrations and DDL
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# 2. Supabase API & Auth
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# 3. Cloudflare R2 Storage (For Private Reference & Participant PDF Uploads)
# -----------------------------------------------------------------------------
# S3-compatible credentials for Cloudflare R2
R2_ACCOUNT_ID="[CLOUDFLARE_ACCOUNT_ID]"
R2_ACCESS_KEY_ID="[R2_ACCESS_KEY_ID]"
R2_SECRET_ACCESS_KEY="[R2_SECRET_ACCESS_KEY]"
R2_BUCKET_NAME="aci-career-edge-assess-private"
R2_PUBLIC_DOMAIN="" # Optional if private bucket using presigned URLs

# -----------------------------------------------------------------------------
# 4. Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
